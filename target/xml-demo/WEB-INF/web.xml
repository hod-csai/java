<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>XML Demo</display-name>

  <servlet>
    <servlet-name>XmlServlet</servlet-name>
    <servlet-class>com.example.XmlServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>XmlServlet</servlet-name>
    <url-pattern>/xml-demo</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>FormServlet</servlet-name>
    <servlet-class>com.example.FormServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FormServlet</servlet-name>
    <url-pattern>/FormServlet</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CookieServlet</servlet-name>
    <servlet-class>com.example.CookieServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CookieServlet</servlet-name>
    <url-pattern>/CookieServlet</url-pattern>
  </servlet-mapping>

</web-app>
